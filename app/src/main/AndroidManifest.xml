<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Audio recording for offline speech recognition and wake-word spotting -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Reading local phone contacts for voice-dialing matching -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Direct calling when enabled by user in settings (otherwise ACTION_DIAL is used) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Internet access used ONLY for optional in-app download of the free offline speech model -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service permissions for background assistant operation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Notification permission for Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Queries to verify available dialer apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".NovaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nova">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Nova">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Voice action support -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Foreground service for continuous listening when enabled -->
        <service
            android:name=".assistant.AssistantService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
